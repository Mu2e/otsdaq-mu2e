# Browser caching for the tutorial site. Pages (.html) stay uncached so edits show at once; every
# image, style and script URL carries ?v=<content hash> from build_site.py, so long caching is safe.
# Wrapped in IfModule: if the web host lacks a module, the directives are skipped instead of erroring.
# recorded tutorial videos are WebM
AddType video/webm .webm
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|gif|css|js|mp4|webm)$">
    # the host adds "private, max-age=0, must-revalidate" to every response; replace it, in both
    # of Apache's header tables, rather than adding a second, conflicting Cache-Control header
    Header unset Cache-Control
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
